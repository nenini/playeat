<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nyamnyam.coach.ai.repository.AiReportRepository">

    <resultMap id="AiReportResultMap" type="com.nyamnyam.coach.ai.entity.AiReport">
        <id property="reportId" column="report_id"/>
        <result property="userId" column="user_id"/>
        <result property="reportType" column="report_type"/>
        <result property="periodStart" column="period_start"/>
        <result property="periodEnd" column="period_end"/>
        <result property="summary" column="summary"/>
        <result property="strengthsJson" column="strengths_json"/>
        <result property="warningsJson" column="warnings_json"/>
        <result property="nextAction" column="next_action"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.nyamnyam.coach.ai.entity.AiReport"
            useGeneratedKeys="true" keyProperty="reportId">
        INSERT INTO ai_reports (
            user_id,
            report_type,
            period_start,
            period_end,
            summary,
            strengths_json,
            warnings_json,
            next_action
        )
        VALUES (
            #{userId},
            #{reportType},
            #{periodStart},
            #{periodEnd},
            #{summary},
            #{strengthsJson},
            #{warningsJson},
            #{nextAction}
        )
    </insert>

    <select id="findByUserIdAndPeriod" resultMap="AiReportResultMap">
        SELECT
            report_id,
            user_id,
            report_type,
            period_start,
            period_end,
            summary,
            strengths_json,
            warnings_json,
            next_action,
            created_at
        FROM ai_reports
        WHERE user_id = #{userId}
          AND report_type = #{reportType}
          AND period_start = #{periodStart}
          AND period_end = #{periodEnd}
    </select>
</mapper>
