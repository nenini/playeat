<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  FoodMapper.xml 예시 — 실제 도메인 구현 시 참고용 템플릿.
  application.yml 의 mybatis.mapper-locations: classpath:mappers/** /*.xml 에 의해 자동 스캔됨.
-->
<mapper namespace="com.nyamnyam.coach.food.mapper.FoodMapper">

    <resultMap id="foodResultMap" type="com.nyamnyam.coach.food.domain.Food">
        <id     column="food_id"       property="foodId"/>
        <result column="food_name"     property="foodName"/>
        <result column="serving_size"  property="servingSize"/>
        <result column="calories"      property="calories"/>
        <result column="protein"       property="protein"/>
        <result column="carbohydrate"  property="carbohydrate"/>
        <result column="fat"           property="fat"/>
        <result column="sodium"        property="sodium"/>
        <result column="created_at"    property="createdAt"/>
    </resultMap>

    <!-- 음식명 검색 (식약처 DB 기반) -->
    <select id="searchByName" resultMap="foodResultMap">
        SELECT food_id, food_name, serving_size,
               calories, protein, carbohydrate, fat, sodium, created_at
        FROM food
        WHERE food_name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY food_name
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByName" resultType="long">
        SELECT COUNT(*)
        FROM food
        WHERE food_name LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <select id="findById" resultMap="foodResultMap">
        SELECT food_id, food_name, serving_size,
               calories, protein, carbohydrate, fat, sodium, created_at
        FROM food
        WHERE food_id = #{foodId}
    </select>

</mapper>
