# =========================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# =========================
# IntelliJ IDEA
# =========================
.idea/
.idea.*/
**/.idea/
**/.idea.*/
*.iml
*.iws
*.ipr
out/

# 단, 팀에서 IntelliJ 설정을 공유하기로 했다면 위 .idea/는 조정 가능
# 지금은 개인 IDE 설정이므로 올리지 않는 것을 추천

# =========================
# Java / Spring Boot / Maven
# =========================
target/
**/target/
*.class
*.jar
*.war
*.ear

# Maven wrapper jar는 보통 올려도 되지만, 필요 없으면 제외
# !.mvn/wrapper/maven-wrapper.jar

# =========================
# Backend local config
# =========================
BackEnd/src/main/resources/application-local.yml
BackEnd/src/main/resources/application-local.yaml
BackEnd/src/main/resources/application-dev.yml
BackEnd/src/main/resources/application-dev.yaml

# 실제 secret, DB 계정, API key 등이 들어갈 수 있는 파일
BackEnd/.env
BackEnd/.env.local
BackEnd/.env.*

# =========================
# Logs
# =========================
*.log
logs/
BackEnd/logs/

